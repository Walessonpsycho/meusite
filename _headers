# Cabeçalhos do Cloudflare Pages

# endereço de teste do Pages: fora do Google (o site oficial é psicologobrasileiroonline.com.br)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# página sempre conferida (atualizações aparecem na hora)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# imagens, fontes e estilos: cache de 30 dias
/img/*
  Cache-Control: public, max-age=2592000
/css/*
  Cache-Control: public, max-age=2592000
/js/*
  Cache-Control: public, max-age=2592000
# fontes não mudam: 1 ano
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
